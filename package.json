{
  "name": "sidekik-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik public API: sessions, consent, off-record, redaction, agent-command egress, proxies, cost ledger, replay",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@supabase/supabase-js": "^2",
    "fastify": "^5",
    "fastify-type-provider-zod": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
