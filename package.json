{
  "name": "sidekik-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik public API: sessions, consent, off-record, redaction, agent-command egress, proxies, cost ledger, replay",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mock": "tsx watch src/dev/mock.ts",
    "dev:replay": "tsx src/dev/replay.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@fastify/rate-limit": "^10",
    "@fastify/websocket": "^11",
    "@sidekik/contracts": "github:sidekik-live/sidekik-platform#v0.3.0",
    "@supabase/supabase-js": "^2",
    "fastify": "^5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "ws": "^8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
